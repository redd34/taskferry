<Project>
  <!--
    Wires a cargo build of a #[dotnet_export] crate into a .NET project.

    Set in the consuming project:
      TokioDotnetCargoTargetDir  cargo target directory (absolute or relative to the project). Required.
      TokioDotnetCargoProfile    target subdirectory holding the cdylib (release, debug, ...). Default: release.
      TokioDotnetLibrary         cdylib name(s), semicolon-separated. Default: first "library" in the manifest.

    Then (AllowUnsafeBlocks is set to true, as the generated code needs it):
      - <target>/tokio-dotnet-bindings.json is added to AdditionalFiles for TokioDotnet.Generator.
      - <target>/<profile>/lib{name}.dylib | lib{name}.so | {name}.dll is copied to the output and publish
        directories (including NativeAOT publish).
  -->
  <PropertyGroup Condition="'$(TokioDotnetCargoTargetDir)' != ''">
    <!-- The generated bindings use pointers (the SDK defaults this to false, so it is forced on). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TokioDotnetCargoProfile Condition="'$(TokioDotnetCargoProfile)' == ''">release</TokioDotnetCargoProfile>
    <_TokioDotnetTargetDir>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(TokioDotnetCargoTargetDir)))</_TokioDotnetTargetDir>
    <_TokioDotnetManifest>$(_TokioDotnetTargetDir)tokio-dotnet-bindings.json</_TokioDotnetManifest>
    <_TokioDotnetNativeDir>$([MSBuild]::NormalizeDirectory($(_TokioDotnetTargetDir), $(TokioDotnetCargoProfile)))</_TokioDotnetNativeDir>
    <TokioDotnetLibrary Condition="'$(TokioDotnetLibrary)' == '' And Exists('$(_TokioDotnetManifest)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_TokioDotnetManifest)')), '"library"\s*:\s*"([^"]+)"').Groups[1].Value)</TokioDotnetLibrary>

    <!-- Native file naming follows the target RID when set, else the build host. -->
    <_TokioDotnetOs Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win</_TokioDotnetOs>
    <_TokioDotnetOs Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx</_TokioDotnetOs>
    <_TokioDotnetOs Condition="$(RuntimeIdentifier.StartsWith('win'))">win</_TokioDotnetOs>
    <_TokioDotnetOs Condition="$(RuntimeIdentifier.StartsWith('osx'))">osx</_TokioDotnetOs>
    <_TokioDotnetPrefix>lib</_TokioDotnetPrefix>
    <_TokioDotnetPrefix Condition="'$(_TokioDotnetOs)' == 'win'"></_TokioDotnetPrefix>
    <_TokioDotnetSuffix>.so</_TokioDotnetSuffix>
    <_TokioDotnetSuffix Condition="'$(_TokioDotnetOs)' == 'win'">.dll</_TokioDotnetSuffix>
    <_TokioDotnetSuffix Condition="'$(_TokioDotnetOs)' == 'osx'">.dylib</_TokioDotnetSuffix>
  </PropertyGroup>

  <ItemGroup Condition="'$(TokioDotnetCargoTargetDir)' != ''">
    <AdditionalFiles Include="$(_TokioDotnetManifest)" Condition="Exists('$(_TokioDotnetManifest)')" />
    <_TokioDotnetNativeLib Include="$(TokioDotnetLibrary)" />
    <_TokioDotnetNativeFile Include="@(_TokioDotnetNativeLib->'$(_TokioDotnetNativeDir)$(_TokioDotnetPrefix)%(Identity)$(_TokioDotnetSuffix)')" />
  </ItemGroup>

  <!-- Before AssignTargetPaths so the copy feeds both the build output and publish (incl. NativeAOT). -->
  <Target Name="TokioDotnetNativeLibrary" BeforeTargets="AssignTargetPaths" Condition="'$(TokioDotnetCargoTargetDir)' != ''">
    <ItemGroup>
      <None Include="@(_TokioDotnetNativeFile)" Condition="Exists('%(_TokioDotnetNativeFile.Identity)')"
            Link="%(_TokioDotnetNativeFile.Filename)%(_TokioDotnetNativeFile.Extension)" Visible="false"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Warning Condition="!Exists('$(_TokioDotnetManifest)')"
             Code="TOKIODOTNET001"
             Text="tokio-dotnet: bindings manifest '$(_TokioDotnetManifest)' not found, so no bindings will be generated. Run `cargo build --release` (or the cargo profile matching TokioDotnetCargoProfile) on the #[dotnet_export] crate first, or fix TokioDotnetCargoTargetDir." />
    <Warning Condition="Exists('$(_TokioDotnetManifest)') And '@(_TokioDotnetNativeFile)' == ''"
             Code="TOKIODOTNET002"
             Text="tokio-dotnet: no native library name found. Set TokioDotnetLibrary to the cdylib name." />
    <Warning Condition="'@(_TokioDotnetNativeFile)' != '' And !Exists('%(_TokioDotnetNativeFile.Identity)')"
             Code="TOKIODOTNET002"
             Text="tokio-dotnet: native library '%(_TokioDotnetNativeFile.Identity)' not found, so it will not be copied to the output. Run `cargo build --release` (or the cargo profile matching TokioDotnetCargoProfile) first, or fix TokioDotnetCargoTargetDir / TokioDotnetCargoProfile / TokioDotnetLibrary." />
  </Target>
</Project>
