<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Taskferry.Runtime</PackageId>
    <Version>0.1.0</Version>
    <Authors>redd34</Authors>
    <Description>Runtime for taskferry: zero-copy, NativeAOT-compatible bridge between async Rust (Tokio, Stream) and .NET Task, IAsyncEnumerable and Memory. Pair with Taskferry.Generator.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/redd34/taskferry</RepositoryUrl>
    <PackageProjectUrl>https://github.com/redd34/taskferry</PackageProjectUrl>
    <PackageTags>rust;tokio;ffi;interop;async;nativeaot;zero-copy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
