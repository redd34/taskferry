<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 2 gate: the generated bindings must publish and run under NativeAOT. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit advisories on the SDK-pinned ILCompiler stay visible as warnings (fix: update the .NET SDK). -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Bindings manifest + native library from the release cargo build (see TokioDotnet.Generator.targets). -->
    <TokioDotnetCargoTargetDir>../../target</TokioDotnetCargoTargetDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TokioDotnet.Runtime/TokioDotnet.Runtime.csproj" />
    <ProjectReference Include="../TokioDotnet.Generator/TokioDotnet.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="../TokioDotnet.Generator/build/TokioDotnet.Generator.targets" />
</Project>
