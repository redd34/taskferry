<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Quick start, from the repository root (exact commands are in the README):
        cargo build (with the release flag), then
        dotnet run on this project
    The single TaskferryCargoTargetDir property wires up the bindings manifest and
    copies the native library next to the app.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TaskferryCargoTargetDir>../../target</TaskferryCargoTargetDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- With the NuGet packages these two lines become PackageReferences and the Import goes away. -->
    <ProjectReference Include="../../dotnet/Taskferry.Runtime/Taskferry.Runtime.csproj" />
    <ProjectReference Include="../../dotnet/Taskferry.Generator/Taskferry.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="../../dotnet/Taskferry.Generator/build/Taskferry.Generator.targets" />
</Project>
